diff --git a/modules/pubpartner_chatgpt_link.py b/modules/pubpartner_chatgpt_link.py
new file mode 100644
index 00000000..598eade9
--- /dev/null
+++ b/modules/pubpartner_chatgpt_link.py
@@ -0,0 +1,171 @@
+"""Session-bound OpenAI consent for a registered PubPartner client.
+
+The browser returns to the same PubPartner tab. Access tokens stay in host
+memory and are usable only with the originating authenticated PubCast session.
+"""
+import base64
+import hashlib
+import os
+import logging
+import secrets
+import time
+from contextvars import ContextVar
+from urllib.parse import urlencode, urlsplit
+from uuid import NAMESPACE_URL, uuid5
+
+import httpx
+from fastapi import HTTPException
+
+ISSUER = "https://auth.openai.com"
+PLAN_SCOPE = "chatgpt.tokens.use.direct"
+current_session = ContextVar("chatgpt_link_session", default="")
+pending = {}
+accounts = {}
+
+
+class CallbackAccessFilter(logging.Filter):
+    """Preserve the access event while removing callback parameters."""
+    def filter(self, record):
+        args = record.args
+        if isinstance(args, tuple) and len(args) == 5 and isinstance(args[2], str):
+            path, separator, _ = args[2].partition("?")
+            if separator and path == "/pubpartner":
+                record.args = (*args[:2], path, *args[3:])
+        return True
+
+
+callback_access_filter = CallbackAccessFilter()
+
+
+def configured():
+    try:
+        callback = urlsplit(os.getenv("PUBPARTNER_OPENAI_CALLBACK", ""))
+        if callback.port == 0:
+            return False
+    except ValueError:
+        return False
+    secure = callback.scheme == "https" or (callback.scheme == "http" and callback.hostname == "127.0.0.1")
+    return bool(os.getenv("PUBPARTNER_OPENAI_CLIENT_ID") and secure and callback.hostname
+                and callback.path == "/pubpartner" and not (callback.query or callback.fragment or callback.username or callback.password))
+
+
+def prune(records):
+    now = time.monotonic()
+    for key in [k for k, item in records.items() if item["expires"] <= now]:
+        records.pop(key, None)
+
+
+def session_id(identity):
+    token_id = (identity.get("payload") or {}).get("jti")
+    return token_id if identity.get("authenticated") and isinstance(token_id, str) else ""
+
+
+def require_session(identity):
+    session = session_id(identity)
+    if not session:
+        raise HTTPException(401, "Sign in to PubCast to link a ChatGPT account.")
+    return session
+
+
+async def metadata(client):
+    response = await client.get(ISSUER + "/.well-known/openid-configuration")
+    response.raise_for_status()
+    doc = response.json()
+    if doc["issuer"] != ISSUER or any(
+        urlsplit(doc[field]).scheme != "https" or urlsplit(doc[field]).netloc != "auth.openai.com"
+        for field in ("authorization_endpoint", "token_endpoint", "jwks_uri")
+    ):
+        raise ValueError("Unexpected OpenID discovery configuration")
+    return doc
+
+
+async def begin(identity, *, host_id, origin):
+    session = require_session(identity)
+    if not configured():
+        raise HTTPException(409, "This host needs a registered PubPartner OpenAI client and callback.")
+    callback = os.environ["PUBPARTNER_OPENAI_CALLBACK"]
+    callback_url = urlsplit(callback)
+    if origin != f"{callback_url.scheme}://{callback_url.netloc}":
+        raise HTTPException(409, "Open PubPartner on the same address as its registered ChatGPT callback.")
+    client_id = os.environ["PUBPARTNER_OPENAI_CLIENT_ID"]
+    prune(pending)
+    state = secrets.token_urlsafe(32)
+    verifier = secrets.token_urlsafe(48)
+    nonce = secrets.token_urlsafe(32)
+    challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).decode().rstrip("=")
+    pending[session] = dict(state=state, verifier=verifier, nonce=nonce, expires=time.monotonic()+600,
+                            callback=callback, client_id=client_id)
+    async with httpx.AsyncClient(timeout=12) as client:
+        doc = await metadata(client)
+    if pending.get(session, {}).get("state") != state:
+        raise HTTPException(409, "This sign-in attempt was cancelled or replaced.")
+    params = dict(ext_agent_host_id=uuid5(NAMESPACE_URL, "pubpartner:openai:" + host_id).urn, client_id=client_id, redirect_uri=callback, response_type="code",
+                  resource="https://api.openai.com/v1", scope=f"openid email profile resource.invoke {PLAN_SCOPE}", prompt="select_account consent",
+                  state=state, nonce=nonce, code_challenge=challenge, code_challenge_method="S256")
+    return {"url": doc["authorization_endpoint"] + "?" + urlencode(params)}
+
+
+async def finish(identity, body):
+    import jwt
+
+    session = require_session(identity)
+    prune(pending)
+    attempt = pending.get(session)
+    if not attempt or attempt.get("used") or not secrets.compare_digest(str(body.get("state", "")).encode(), attempt["state"].encode()):
+        raise HTTPException(400, "This sign-in request expired or belongs to another session.")
+    attempt["used"] = True
+    if body.get("error") or not body.get("code"):
+        raise HTTPException(400, "Account connection cancelled.")
+    client_id = attempt["client_id"]
+    if body.get("client_id", client_id) != client_id:
+        raise HTTPException(400, "Client registration changed during sign-in.")
+    async with httpx.AsyncClient(timeout=15) as client:
+        doc = await metadata(client)
+        form = dict(client_id=client_id, redirect_uri=attempt["callback"], grant_type="authorization_code",
+                    resource="https://api.openai.com/v1", code=body["code"], code_verifier=attempt["verifier"])
+        secret = os.getenv("PUBPARTNER_OPENAI_CLIENT_SECRET")
+        response = await client.post(doc["token_endpoint"], data=form, auth=(client_id, secret) if secret else None)
+        response.raise_for_status()
+        tokens = response.json()
+        keys = await client.get(doc["jwks_uri"])
+        keys.raise_for_status()
+        encoded = tokens["id_token"]
+        kid = jwt.get_unverified_header(encoded)["kid"]
+        key = next((k for k in jwt.PyJWKSet.from_dict(keys.json()).keys if k.key_id == kid), None)
+        if key is None:
+            raise ValueError("Unknown identity signing key")
+        claims = jwt.decode(encoded, key.key, algorithms=["RS256"], issuer=ISSUER, audience=client_id,
+                            options={"require":["sub","iat","exp","nonce"]})
+        if claims["nonce"] != attempt["nonce"] or claims.get("azp", client_id) != client_id:
+            raise ValueError("Identity did not match sign-in request")
+        access = ""
+        models = []
+        if PLAN_SCOPE in tokens.get("scope", "").split():
+            access = tokens["access_token"]
+            catalog = await client.get("https://api.openai.com/v1/models", headers={"Authorization":"Bearer "+access})
+            catalog.raise_for_status()
+            models = [m["slug"] for m in catalog.json().get("models", [])
+                      if m.get("visibility") == "list" and m.get("slug")]
+    prune(pending)
+    if pending.get(session) is not attempt:
+        raise HTTPException(409, "This sign-in attempt expired, was disconnected, or was replaced.")
+    del pending[session]
+    prune(accounts)
+    accounts[session] = dict(access=access, models=models, label=claims.get("email") or claims["sub"],
+                             expires=time.monotonic()+int(tokens["expires_in"]))
+    return status(session)
+
+
+def status(session):
+    prune(accounts)
+    record = accounts.get(session)
+    return {"configured": configured(), "linked": bool(record), "plan_enabled": bool(record and record["access"]), "label": record["label"] if record else "",
+            "models": record["models"] if record else []}
+
+
+def token_for_model(model):
+    prune(accounts)
+    record = accounts.get(current_session.get())
+    if not record or model not in record["models"]:
+        raise ValueError("Reconnect ChatGPT and select a model offered by this account.")
+    return record["access"]
diff --git a/modules/pubpartner_connector_host.py b/modules/pubpartner_connector_host.py
new file mode 100644
index 00000000..d58e6389
--- /dev/null
+++ b/modules/pubpartner_connector_host.py
@@ -0,0 +1,197 @@
+"""Owner-operated, fixed-target MCP launcher for a running Reach host."""
+import asyncio
+import io
+import json
+import tempfile
+import zipfile
+
+import sqlite3
+from importlib.util import find_spec
+import os
+from pathlib import Path
+import shutil
+import sys
+import secrets
+
+import httpx
+
+
+class ConnectorHost:
+    def __init__(self, data_dir):
+        self.selected = Path(data_dir) / "secure" / "connector" / "selected.zip"
+        self.tunnel_record = self.selected.with_name("workspace-tunnel.json")
+        self.process = None
+        self.route = None
+        self.starting = False
+        self.lock = asyncio.Lock()
+
+    def source(self):
+        if self.selected.is_file():
+            return self.selected
+        configured = os.getenv("PUBPARTNER_CONNECTOR_CARTRIDGE")
+        return Path(configured) if configured else None
+
+    async def select(self, payload):
+        async with self.lock:
+            if self.status()["running"]:
+                raise ValueError("Stop the running connector before selecting another cartridge.")
+            await asyncio.to_thread(self.validate, payload)
+            self.selected.parent.mkdir(parents=True, exist_ok=True)
+            with tempfile.NamedTemporaryFile(dir=self.selected.parent, delete=False) as tmp:
+                tmp.write(payload)
+            try:
+                os.replace(tmp.name, self.selected)
+            finally:
+                Path(tmp.name).unlink(missing_ok=True)
+            return self.status()
+
+    @staticmethod
+    def validate(payload):
+        from pubpartner.cartridge import load_cartridge
+        with zipfile.ZipFile(io.BytesIO(payload)) as archive:
+            entries = archive.infolist()
+            files = [entry for entry in entries if not entry.is_dir()]
+            if len(entries) > 129 or sum(entry.file_size for entry in entries) > 16 * 1024 * 1024:
+                raise ValueError("Choose a cartridge up to 16 MiB unpacked.")
+            parents = {Path(entry.filename).parent for entry in files}
+            if len(parents) != 1:
+                raise ValueError("Choose one folder of cartridge files.")
+            folder = parents.pop()
+            if (len(folder.parts) > 1 or len({entry.filename for entry in entries}) != len(entries)
+                    or any(".." in entry.filename or "\\" in entry.filename or ":" in entry.filename
+                           or entry.filename.startswith("/") or (entry.is_dir() and Path(entry.filename) != folder)
+                           for entry in entries)):
+                raise ValueError("Choose a cartridge with at most one outer folder.")
+            with tempfile.TemporaryDirectory() as scratch:
+                archive.extractall(scratch)
+                try:
+                    with load_cartridge(Path(scratch) / folder) as cartridge:
+                        cartridge.memory.count()
+                except sqlite3.Error:
+                    raise ValueError("The cartridge memory database could not be read.") from None
+
+    def tunnel_id(self):
+        configured = os.getenv("CONTROL_PLANE_TUNNEL_ID")
+        if configured:
+            return configured
+        if self.tunnel_record.is_file():
+            try:
+                record = json.loads(self.tunnel_record.read_text())
+            except (UnicodeError, ValueError, OSError):
+                return None
+            if not isinstance(record, dict):
+                return None
+            if record.get("workspace") == os.getenv("PUBPARTNER_OPENAI_WORKSPACE_ID"):
+                return record.get("id")
+        return None
+
+    async def create_tunnel(self):
+        # Reserve creation before the external call. A lost response must not
+        # create a second workspace resource when the owner retries.
+        workspace = os.environ["PUBPARTNER_OPENAI_WORKSPACE_ID"]
+        self.tunnel_record.parent.mkdir(parents=True, exist_ok=True)
+        try:
+            with self.tunnel_record.open("x") as handle:
+                json.dump({"workspace": workspace}, handle)
+        except FileExistsError:
+            raise ValueError("Check the workspace tunnel list and set CONTROL_PLANE_TUNNEL_ID to resume.") from None
+        proc = await asyncio.create_subprocess_exec(
+            shutil.which("tunnel-client"), "admin", "tunnels", "create", "--name", "PubPartner",
+            "--description", "Owner-selected PubPartner cartridge", "--workspace-id", workspace, "--json",
+            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
+        output, _ = await proc.communicate()
+        if proc.returncode:
+            raise ValueError("Creation was not confirmed. Check the workspace tunnel list before retrying.")
+        tunnel_id = json.loads(output).get("id")
+        if not isinstance(tunnel_id, str) or not tunnel_id:
+            raise ValueError("Check the workspace tunnel list for the new tunnel ID.")
+        with tempfile.NamedTemporaryFile(mode="w", dir=self.tunnel_record.parent, delete=False) as tmp:
+            json.dump({"workspace": workspace, "id": tunnel_id}, tmp)
+        os.replace(tmp.name, self.tunnel_record)
+        return tunnel_id
+
+    def status(self):
+        source = self.source()
+        tunnel_id = self.tunnel_id()
+        return {
+            "cartridge_configured": bool(source and Path(source).exists()),
+            "sdk_installed": find_spec("mcp") is not None,
+            "tunnel_installed": bool(shutil.which("tunnel-client")),
+            "can_create_tunnel": bool(not self.tunnel_record.exists() and os.getenv("OPENAI_ADMIN_KEY")
+                                     and os.getenv("PUBPARTNER_OPENAI_WORKSPACE_ID")
+                                     and (os.getenv("CONTROL_PLANE_API_KEY") or os.getenv("OPENAI_API_KEY"))),
+            "tunnel_id": tunnel_id,
+            "tunnel_needs_recovery": self.tunnel_record.exists() and not tunnel_id,
+            "tunnel_configured": bool(tunnel_id and
+                                      (os.getenv("CONTROL_PLANE_API_KEY") or os.getenv("OPENAI_API_KEY"))),
+            "starting": self.starting,
+            "running": not self.starting and self.process is not None and self.process.returncode is None,
+            "route": self.route,
+            "exit_code": self.process.returncode if self.process else None,
+        }
+
+    async def start(self, route, create=False):
+        async with self.lock:
+            status = self.status()
+            if status["running"]:
+                if self.route == route:
+                    return status
+                raise ValueError("Stop the current connector before switching routes.")
+            if not status["sdk_installed"] or not status["cartridge_configured"]:
+                raise ValueError("Configure the host cartridge and install the connector SDK.")
+            source = self.source().resolve()
+            if route == "http":
+                command = [sys.executable, "-m", "pubpartner.connector", str(source), "--transport", "http"]
+            elif route == "openai-tunnel":
+                from pubpartner.connector import tunnel_command
+                tunnel_id = self.tunnel_id()
+                if not tunnel_id and create and status["tunnel_installed"] and status["can_create_tunnel"]:
+                    tunnel_id = await self.create_tunnel()
+                command = tunnel_command(source, tunnel_id)
+            else:
+                raise ValueError("Unknown connector route")
+            launch_id = secrets.token_hex(16)
+            self.process = await asyncio.create_subprocess_exec(
+                *command, stdin=asyncio.subprocess.DEVNULL, env={**os.environ, "PUBPARTNER_LAUNCH_ID": launch_id})
+            self.route = route
+            if route == "http":
+                self.starting = True
+                try:
+                    async with asyncio.timeout(25), httpx.AsyncClient(timeout=.5, trust_env=False) as client:
+                        while self.process.returncode is None:
+                            try:
+                                response = await client.get("http://127.0.0.1:8768/ready")
+                                if response.status_code == 200 and response.text == launch_id:
+                                    self.starting = False
+                                    return self.status()
+                            except httpx.HTTPError:
+                                pass
+                            await asyncio.sleep(.1)
+                        raise ValueError("Local MCP exited before startup. Check the cartridge and whether port 8768 is in use.")
+                except (asyncio.CancelledError, TimeoutError) as error:
+                    await self._stop_process()
+                    if isinstance(error, TimeoutError):
+                        raise ValueError("Local MCP did not become ready on port 8768.") from None
+                    raise
+                finally:
+                    self.starting = False
+            return self.status()
+
+    async def stop(self):
+        async with self.lock:
+            await self._stop_process()
+            return self.status()
+
+    async def _stop_process(self):
+        if self.process and self.process.returncode is None:
+            try:
+                self.process.terminate()
+                try:
+                    await asyncio.wait_for(self.process.wait(), 8)
+                except asyncio.TimeoutError:
+                    self.process.kill()
+                    await self.process.wait()
+            except ProcessLookupError:
+                pass
+        self.process = None
+        self.route = None
