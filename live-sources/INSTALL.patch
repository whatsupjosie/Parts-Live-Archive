+def _chain(chunks):
+    from modules.studio25d_recording_ingest import CHAIN_SEED, extend_chain
+    chain = CHAIN_SEED
+    for chunk in chunks:
+        chain = extend_chain(chain, hashlib.sha256(chunk).hexdigest(), len(chunk))
+    return chain
+
