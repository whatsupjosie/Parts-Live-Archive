diff --git a/static/camera_connect.js b/static/camera_connect.js
new file mode 100644
index 00000000..c3d66327
--- /dev/null
+++ b/static/camera_connect.js
@@ -0,0 +1,246 @@
+/* Connect this phone or laptop as a studio camera and microphone.
+ *
+ * While connected: the studio sees a live preview feed (JPEG frames through the existing 2.5D confidence-frame publisher,
+ * static/production25d_frame_publisher.js). While recording: the browser records picture AND sound locally and, on stop,
+ * uploads the take through the existing chunked, hash-chained ingest (/api/studio25d/recordings) so the host verifies
+ * every byte. The chain function below is the same as static/production25d_archive.js (CHAIN seed and layout).
+ *
+ * The live feed is a preview, not broadcast video: low frame rate JPEGs. The recorded take is the full-quality media.
+ */
+(function () {
+  "use strict";
+  const CHUNK = 256 * 1024, SEED = "pubcast-encoded-take/1";
+  const $ = id => document.getElementById(id);
+  const debug = { state: "starting", frames: 0, level: 0, sourceId: null, mime: null, hasAudio: false, lastTake: null, errors: [], recordedBytes: 0 };
+  window.__camConnect = debug;
+
+  const hex = b => Array.from(new Uint8Array(b), v => v.toString(16).padStart(2, "0")).join("");
+  const unhex = s => Uint8Array.from(s.match(/../g) || [], v => parseInt(v, 16));
+  const sha = async data => hex(await crypto.subtle.digest("SHA-256", data));
+  const rand = n => hex(crypto.getRandomValues(new Uint8Array(n)));
+  async function chainStep(previous, digest, size) {
+    const bytes = new Uint8Array(72);
+    bytes.set(unhex(previous)); bytes.set(unhex(digest), 32);
+    new DataView(bytes.buffer).setUint32(68, size);
+    return sha(bytes);
+  }
+
+  let stream = null, publisher = null, publishTimer = null, audioCtx = null, levelTimer = null;
+  let recorder = null, pieces = [], recordStartedAt = 0, pending = null, sessionId = null;
+
+  function say(text, bad) { const s = $("status"); s.textContent = text; s.classList.toggle("bad", !!bad); if (bad) debug.errors.push(text); }
+  function setButtons() {
+    const live = !!stream, rec = !!recorder;
+    $("connect").disabled = live || debug.state === "unauthenticated" || debug.state === "starting";
+    $("record").disabled = !live;
+    $("record").textContent = rec ? "Stop and upload" : "Record take";
+    $("disconnect").disabled = !live;
+    $("cam").disabled = live; $("mic").disabled = live; $("name").disabled = live;
+    $("retry").hidden = !pending;
+  }
+
+  async function api(path, init) {
+    const r = await fetch(path, { credentials: "same-origin", ...init });
+    if (!r.ok) {
+      let detail = ""; try { detail = (await r.json()).detail; } catch (_) {}
+      const err = new Error(`${path} → HTTP ${r.status}${detail ? ": " + (typeof detail === "string" ? detail : JSON.stringify(detail)) : ""}`);
+      err.status = r.status; throw err;
+    }
+    return r.status === 204 ? null : r.json();
+  }
+
+  async function fillDevices() {
+    const list = await navigator.mediaDevices.enumerateDevices();
+    for (const [id, kind] of [["cam", "videoinput"], ["mic", "audioinput"]]) {
+      const select = $(id), keep = select.value;
+      select.innerHTML = "";
+      const none = new Option(id === "mic" ? "Default microphone" : "Default camera", ""); select.add(none);
+      list.filter(d => d.kind === kind).forEach((d, i) => select.add(new Option(d.label || `${kind} ${i + 1}`, d.deviceId)));
+      if (keep) select.value = keep;
+    }
+  }
+
+  function pickMime() {
+    for (const m of ["video/webm;codecs=vp9,opus", "video/webm;codecs=vp8,opus", "video/webm", "video/mp4"]) {
+      if (window.MediaRecorder && MediaRecorder.isTypeSupported(m)) return m;
+    }
+    return "";
+  }
+
+  function startMeter() {
+    const track = stream.getAudioTracks()[0];
+    debug.hasAudio = !!track;
+    if (!track) return;
+    audioCtx = new (window.AudioContext || window.webkitAudioContext)();
+    const analyser = audioCtx.createAnalyser(); analyser.fftSize = 1024;
+    audioCtx.createMediaStreamSource(new MediaStream([track])).connect(analyser);
+    const data = new Uint8Array(analyser.fftSize);
+    levelTimer = setInterval(() => {
+      analyser.getByteTimeDomainData(data);
+      let peak = 0; for (const v of data) peak = Math.max(peak, Math.abs(v - 128) / 128);
+      debug.level = Math.max(debug.level * 0.7, peak);      // decays so a brief sound is visible to a person and to a test
+      $("meter").firstElementChild.style.width = Math.min(100, Math.round(debug.level * 140)) + "%";
+    }, 80);
+  }
+
+  async function connect() {
+    try {
+      say("Asking for camera and microphone…");
+      const cam = $("cam").value, mic = $("mic").value;
+      const constraints = {
+        video: cam ? { deviceId: { exact: cam }, width: { ideal: 1280 }, height: { ideal: 720 } } : { facingMode: "environment", width: { ideal: 1280 }, height: { ideal: 720 } },
+        // Raw audio: echo cancellation and gain control are made for phone calls and ruin a studio microphone.
+        audio: { ...(mic ? { deviceId: { exact: mic } } : {}), echoCancellation: false, noiseSuppression: false, autoGainControl: false },
+      };
+      try { stream = await navigator.mediaDevices.getUserMedia(constraints); }
+      catch (e) {
+        if (e && e.name === "NotFoundError" || e && e.name === "OverconstrainedError") {
+          // No microphone (or that exact device is gone): connect the picture alone and say so.
+          stream = await navigator.mediaDevices.getUserMedia({ video: constraints.video, audio: false });
+          say("No microphone available: connected with picture only.", true);
+        } else throw e;
+      }
+      const video = $("preview"); video.srcObject = stream; await video.play();
+      await fillDevices();
+      startMeter();
+      const name = ($("name").value || "Phone camera").trim().slice(0, 64);
+      debug.sourceId = "p25d_conn_" + rand(6);
+      await api("/api/cameras/register", { method: "POST", headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ source_id: debug.sourceId, name, location: "studio25d", tags: ["studio25d"] }) });
+      sessionId = "conn" + rand(10);
+      publisher = PubCast25DFramePublisher.create({ session: sessionId, sourceId: () => debug.sourceId,
+        onState: s => { if (s.frames !== undefined) debug.frames = s.frames; },
+        onError: m => { debug.errors.push(m); } });
+      publishTimer = setInterval(() => { if (video.videoWidth) publisher.publish("cam", video); }, 250);
+      debug.state = "connected";
+      say(`Connected as ${name}.\nThe studio can see this camera. ${debug.hasAudio ? "Microphone is on." : "No microphone."}`);
+    } catch (e) {
+      await teardown();
+      debug.state = "error";
+      const permission = e && (e.name === "NotAllowedError" || e.name === "SecurityError");
+      say(permission ? "The browser blocked camera access. Allow camera and microphone for this page (it must be opened over https or localhost)." : `Could not connect: ${e.message || e}`, true);
+    }
+    setButtons();
+  }
+
+  function startRecording() {
+    const mime = pickMime();
+    if (!mime) { say("This browser cannot record video.", true); return; }
+    pieces = []; debug.recordedBytes = 0; debug.mime = mime;
+    recorder = new MediaRecorder(stream, { mimeType: mime, videoBitsPerSecond: 4_000_000, audioBitsPerSecond: 160_000 });
+    recorder.ondataavailable = e => { if (e.data && e.data.size) { pieces.push(e.data); debug.recordedBytes += e.data.size; } };
+    recorder.start(1000);
+    recordStartedAt = performance.now();
+    debug.state = "recording";
+    say("Recording. Press Stop and upload when finished.");
+  }
+
+  function stopRecording(incomplete) {
+    return new Promise(resolve => {
+      const r = recorder; recorder = null;
+      r.onstop = async () => {
+        const blob = new Blob(pieces, { type: debug.mime || "video/webm" }); pieces = [];
+        const video = $("preview");
+        const durationMs = Math.max(1, Math.round(performance.now() - recordStartedAt));
+        const device = (stream && stream.getVideoTracks()[0] && stream.getVideoTracks()[0].label) || "";
+        resolve({ blob, durationMs, width: video.videoWidth || 1280, height: video.videoHeight || 720, incomplete: !!incomplete, device });
+      };
+      r.stop();
+    });
+  }
+
+  async function upload(job) {
+    if (!crypto.subtle) throw new Error("Saving takes needs https or localhost for media integrity checks");
+    const { blob } = job;
+    if (!job.spec) {
+      const digests = [], chains = [await sha(new TextEncoder().encode(SEED))];
+      for (let o = 0; o < blob.size; o += CHUNK) {
+        const bytes = await blob.slice(o, o + CHUNK).arrayBuffer();
+        const d = await sha(bytes); digests.push(d);
+        chains.push(await chainStep(chains.at(-1), d, Math.min(CHUNK, blob.size - o)));
+      }
+      job.digests = digests; job.chains = chains;
+      job.spec = { take_id: "take_" + rand(8), production_id: "conn_" + rand(6), source_id: debug.sourceId, mime: blob.type || debug.mime,
+        bytes: blob.size, chain: chains.at(-1), width: job.width, height: job.height, duration_ms: job.durationMs,
+        capture_incomplete: job.incomplete, manifest: { origin: "camera_connect", device: job.device.slice(0, 120), recorded_at: new Date().toISOString() } };
+    }
+    debug.state = "uploading";
+    let ack = await api("/api/studio25d/recordings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(job.spec) });
+    for (let i = ack.next_index; i < job.digests.length; i++) {
+      say(`Uploading ${Math.round((i / job.digests.length) * 100)}%`);
+      let tries = 0;
+      for (;;) {
+        try {
+          ack = await api(`/api/studio25d/recordings/${ack.id}/chunks/${i}`, { method: "PUT",
+            headers: { "Content-Type": "application/octet-stream", "X-Chunk-SHA256": job.digests[i] }, body: blob.slice(i * CHUNK, (i + 1) * CHUNK) });
+          break;
+        } catch (e) { if (++tries >= 3) throw e; await new Promise(r => setTimeout(r, 400 * tries)); }
+      }
+      if (ack.next_index !== i + 1) throw new Error("The host did not keep exactly the chunk that was sent");
+    }
+    ack = await api(`/api/studio25d/recordings/${ack.id}/complete`, { method: "POST" });
+    if (ack.state !== "complete" || !/^[a-f0-9]{64}$/.test(ack.sha256 || "")) throw new Error("The host did not confirm a validated take");
+    return ack;
+  }
+
+  async function finish(job) {
+    pending = job; setButtons();
+    try {
+      const ack = await upload(job);
+      pending = null;
+      debug.lastTake = { id: ack.id, bytes: ack.received_bytes, sha256: ack.sha256, mime: job.spec.mime, incomplete: job.incomplete };
+      debug.state = stream ? "connected" : "idle";
+      say(`Saved on the studio: ${ack.received_bytes} bytes, verified.${job.incomplete ? "\nThis take was cut short by disconnecting." : ""}`);
+      $("result").innerHTML = "";
+      const a = document.createElement("a"); a.href = `/api/studio25d/recordings/${encodeURIComponent(ack.id)}/media`; a.textContent = "Download this take";
+      $("result").append(a);
+    } catch (e) {
+      debug.state = "upload_failed";
+      say(`Upload did not finish: ${e.message}\nYour recording is still on this device. Press Retry upload; it resumes where it stopped.`, true);
+    }
+    setButtons();
+  }
+
+  async function teardown() {
+    clearInterval(publishTimer); clearInterval(levelTimer); publishTimer = levelTimer = null;
+    if (publisher) { try { await publisher.stop(); } catch (_) {} publisher = null; }
+    if (audioCtx) { try { await audioCtx.close(); } catch (_) {} audioCtx = null; }
+    if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
+    $("preview").srcObject = null;
+    $("meter").firstElementChild.style.width = "0";
+  }
+
+  $("connect").onclick = connect;
+  $("record").onclick = async () => {
+    if (!recorder) { startRecording(); setButtons(); return; }
+    const job = await stopRecording(false);
+    await finish(job);
+  };
+  $("disconnect").onclick = async () => {
+    let job = null;
+    if (recorder) job = await stopRecording(true);        // keep what was recorded rather than throw it away
+    await teardown();
+    debug.state = "idle"; say("Disconnected."); setButtons();
+    if (job) await finish(job);
+  };
+  $("retry").onclick = async () => { if (pending) await finish(pending); };
+
+  (async function init() {
+    try {
+      const who = await api("/api/auth/verify");
+      if (!who || !who.valid) throw Object.assign(new Error("not signed in"), { status: 401 });
+      debug.state = "ready";
+      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
+        say("This page needs https or localhost to use the camera. Open the studio's secure address.", true); debug.state = "unsupported"; return;
+      }
+      say(`Signed in as ${who.username}. Press Connect.`);
+      try { await fillDevices(); } catch (_) {}
+    } catch (e) {
+      debug.state = "unauthenticated";
+      say("Sign in first.", true);
+      const a = document.createElement("a"); a.href = "/static/login.html?next=" + encodeURIComponent(location.pathname);
+      a.textContent = "Open sign-in"; $("result").append(a);
+    }
+    setButtons();
+  })();
+})();
diff --git a/static/glb_buffer_repair.js b/static/glb_buffer_repair.js
new file mode 100644
index 00000000..76fbaab2
--- /dev/null
+++ b/static/glb_buffer_repair.js
@@ -0,0 +1,47 @@
+/* In-memory repair for GLB files whose bufferViews omit the required "buffer" index.
+ *
+ * assets/avatar/manny.glb and assets/avatar/sheila.glb have all seven bufferViews without "buffer", which the glTF
+ * 2.0 spec requires; three.js's GLTFLoader refuses them ("Cannot read properties of undefined (reading 'type')").
+ * When the file declares exactly one buffer there is only one thing the index can mean, so it is filled in with 0
+ * in memory. The file on disk is never changed, and a GLB that is already valid is returned byte-for-byte as given.
+ * Anything this cannot repair with certainty (several buffers, bad header, bad JSON chunk) is returned untouched.
+ */
+(function (root, factory) {
+  const api = factory();
+  if (typeof module === "object" && module.exports) module.exports = api;
+  else root.PubCastGlbBufferRepair = api;
+})(typeof globalThis !== "undefined" ? globalThis : this, function () {
+  "use strict";
+  const MAGIC = 0x46546c67, JSON_CHUNK = 0x4e4f534a;
+
+  function repair(input) {
+    const unchanged = { buffer: input, repaired: 0 };
+    if (!(input instanceof ArrayBuffer) || input.byteLength < 20) return unchanged;
+    const view = new DataView(input);
+    if (view.getUint32(0, true) !== MAGIC || view.getUint32(4, true) !== 2) return unchanged;
+    const jsonLength = view.getUint32(12, true);
+    if (view.getUint32(16, true) !== JSON_CHUNK || 20 + jsonLength > input.byteLength) return unchanged;
+    let doc;
+    try { doc = JSON.parse(new TextDecoder().decode(new Uint8Array(input, 20, jsonLength))); } catch (_) { return unchanged; }
+    const views = Array.isArray(doc.bufferViews) ? doc.bufferViews : [];
+    const missing = views.filter(v => v && typeof v === "object" && v.buffer === undefined);
+    if (!missing.length) return unchanged;
+    if (!Array.isArray(doc.buffers) || doc.buffers.length !== 1) return unchanged;
+    for (const v of missing) v.buffer = 0;
+    const encoded = new TextEncoder().encode(JSON.stringify(doc));
+    const padded = new Uint8Array(Math.ceil(encoded.length / 4) * 4).fill(0x20);
+    padded.set(encoded);
+    const rest = new Uint8Array(input, 20 + jsonLength);
+    const out = new Uint8Array(20 + padded.length + rest.length);
+    const outView = new DataView(out.buffer);
+    out.set(new Uint8Array(input, 0, 12), 0);
+    outView.setUint32(8, out.length, true);
+    outView.setUint32(12, padded.length, true);
+    outView.setUint32(16, JSON_CHUNK, true);
+    out.set(padded, 20);
+    out.set(rest, 20 + padded.length);
+    return { buffer: out.buffer, repaired: missing.length };
+  }
+
+  return { repair };
+});
diff --git a/tests/test_camera_avatar_live.py b/tests/test_camera_avatar_live.py
new file mode 100644
index 00000000..d10f54cc
--- /dev/null
+++ b/tests/test_camera_avatar_live.py
@@ -0,0 +1,273 @@
+"""A 3D avatar in front of a camera, moving live.
+
+Two layers:
+
+* quick checks of the host route that serves a camera's authoritative pose and the avatar's motion, and
+* one end-to-end proof that starts the real host (``run_reach.py``, throwaway data folder), registers a studio 2.5D
+  camera through the real API, opens ``static/camera_avatar_live.html`` in real Chromium (WebGL) with Josie's
+  ``assets/avatar/manny.glb``, and judges the *pixels the camera produced*, fetched back from the host's own frame
+  endpoint as JPEG: the avatar is on screen, the frames change over time (it moves), and moving the camera through
+  ``/api/switcher/ptz`` changes the avatar's size and position in frame the way a real camera move would.
+
+Set CAMERA_EVIDENCE_DIR to keep the captured frames. Skips without Playwright/Chromium.
+"""
+from __future__ import annotations
+
+import io
+import math
+import os
+import secrets
+import socket
+import subprocess
+import sys
+import time
+from pathlib import Path
+
+import httpx
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from modules import camera_view_routes
+from modules.cameras import CameraManager, CameraSource, CameraTransport
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+# --- host route and motion ------------------------------------------------------------------------------
+def test_demo_motion_is_deterministic_finite_and_moves_over_time():
+    a = camera_view_routes.demo_motion("avatar", 3.0)
+    assert a == camera_view_routes.demo_motion("avatar", 3.0)
+    assert a["avatar_id"] == "avatar"
+    later = camera_view_routes.demo_motion("avatar", 3.4)
+    assert later["bones"] != a["bones"]
+    for command in (a, later):
+        for bone in command["bones"].values():
+            assert len(bone["rotation"]) == 3 and all(math.isfinite(v) for v in bone["rotation"])
+            assert all(abs(v) <= 35 for v in bone["rotation"]), "stays inside the consumer's 35 degree default limit"
+
+
+@pytest.mark.parametrize("bad", [float("nan"), float("inf")])
+def test_demo_motion_rejects_non_finite_time(bad):
+    with pytest.raises(ValueError):
+        camera_view_routes.demo_motion("avatar", bad)
+
+
+@pytest.fixture
+def view_client(monkeypatch):
+    async def allowed():
+        return {"authenticated": True, "role": "crew"}
+    monkeypatch.setattr(camera_view_routes, "require_role", lambda role: allowed)
+    cameras = CameraManager()
+    cameras.register(CameraSource(source_id="cam_a", name="A", location="virtual", description="test camera", transport=CameraTransport.VIRTUAL,
+                                  endpoint="virtual://cam_a", position=(0.0, 1.5, 4.0), rotation=(5.0, 10.0, 0.0), fov=40.0))
+    clock = {"t": 100.0}
+    app = FastAPI()
+    app.include_router(camera_view_routes.create_camera_view_router(cameras, clock=lambda: clock["t"]))
+    return TestClient(app), cameras, clock
+
+
+def test_state_reports_the_registry_pose_and_changes_with_it(view_client):
+    client, cameras, clock = view_client
+    body = client.get("/api/camera-view/state/cam_a?avatar=manny").json()
+    assert body["pose"]["position"] == [0.0, 1.5, 4.0] and body["pose"]["rotation"] == [5.0, 10.0, 0.0] and body["pose"]["fov"] == 40.0
+    assert body["motion"]["source"] == "demo_performer" and body["motion"]["avatar_id"] == "manny"
+    assert body["program"] is False
+    assert cameras.update_pose("cam_a", position=[1.0, 2.0, 3.0], fov=60.0)
+    moved = client.get("/api/camera-view/state/cam_a?avatar=manny").json()
+    assert moved["pose"]["position"] == [1.0, 2.0, 3.0] and moved["pose"]["fov"] == 60.0
+    clock["t"] = 100.5
+    assert client.get("/api/camera-view/state/cam_a?avatar=manny").json()["motion"]["bones"] != body["motion"]["bones"]
+
+
+def test_state_marks_the_program_camera(view_client):
+    client, cameras, _ = view_client
+    assert cameras.set_program_source("cam_a")
+    assert client.get("/api/camera-view/state/cam_a").json()["program"] is True
+
+
+def test_state_rejects_unknown_camera_and_bad_avatar_ids(view_client):
+    client, _, _ = view_client
+    assert client.get("/api/camera-view/state/nope").status_code == 404
+    assert client.get("/api/camera-view/state/cam_a?avatar=../x").status_code == 400
+    assert client.get("/api/camera-view/state/cam_a?avatar=" + "a" * 65).status_code == 400
+
+
+# --- the real thing -------------------------------------------------------------------------------------
+sync_api = pytest.importorskip("playwright.sync_api")
+np = pytest.importorskip("numpy")
+PIL_Image = pytest.importorskip("PIL.Image")
+
+CAM = "p25d_avatar_cam"
+
+
+def _free_port() -> int:
+    with socket.socket() as s:
+        s.bind(("127.0.0.1", 0))
+        return s.getsockname()[1]
+
+
+@pytest.fixture(scope="module")
+def host(tmp_path_factory):
+    data = tmp_path_factory.mktemp("camera_view_userdata")
+    port = _free_port()
+    log = open(data / "host.log", "w", encoding="utf-8")
+    proc = subprocess.Popen([sys.executable, "run_reach.py", "--port", str(port), "--data-dir", str(data),
+                             "--no-browser", "--no-legacy-2i"], cwd=str(ROOT), stdout=log, stderr=subprocess.STDOUT)
+    base = f"http://127.0.0.1:{port}"
+    try:
+        deadline = time.time() + 120
+        while time.time() < deadline:
+            if proc.poll() is not None:
+                log.flush()
+                raise AssertionError("run_reach.py exited during startup:\n" + (data / "host.log").read_text(encoding="utf-8")[-4000:])
+            try:
+                if httpx.get(base + "/health", timeout=0.5).status_code == 200:
+                    break
+            except httpx.RequestError:
+                pass
+            time.sleep(0.3)
+        else:
+            raise AssertionError("PubCast did not start within 120 s")
+        password = secrets.token_urlsafe(20)
+        user = "camera-proof"
+        assert httpx.post(base + "/api/auth/setup", json={"username": user, "password": password, "confirm_password": password}, timeout=10).status_code in (200, 201)
+        login = httpx.post(base + "/api/auth/login", json={"username": user, "password": password}, timeout=10)
+        assert login.status_code == 200, login.text
+        yield {"base": base, "user": user, "password": password, "auth": {"Authorization": "Bearer " + login.json()["access_token"]}}
+    finally:
+        proc.terminate()
+        try:
+            proc.wait(20)
+        except subprocess.TimeoutExpired:
+            proc.kill(); proc.wait(5)
+        log.close()
+
+
+def _avatar_mask(img) -> "np.ndarray":
+    """The avatar is Manny's emissive cyan; the floor, grid and backdrop are dark and neutral."""
+    a = np.asarray(img.convert("RGB")).astype(int)
+    return (a[..., 1] > 170) & (a[..., 2] > 170) & (a[..., 0] < 110)
+
+
+def _bbox(mask):
+    ys, xs = np.where(mask)
+    assert len(xs) > 50, "no avatar pixels in the camera's frame"
+    return xs.min(), ys.min(), xs.max(), ys.max()
+
+
+def _fetch_frame(host, sequence_after=0, timeout=10.0):
+    """The newest JPEG the host holds for the camera, newer than ``sequence_after``. Returns (sequence, image, raw bytes)."""
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        r = httpx.get(host["base"] + f"/api/studio25d/media/frames/{CAM}", headers=host["auth"], timeout=5)
+        if r.status_code == 200 and int(r.headers["X-Studio-Sequence"]) > sequence_after:
+            assert r.headers["content-type"] == "image/jpeg"
+            return int(r.headers["X-Studio-Sequence"]), PIL_Image.open(io.BytesIO(r.content)).convert("RGB"), r.content
+        time.sleep(0.1)
+    raise AssertionError(f"no new frame for {CAM} after sequence {sequence_after}: last status {r.status_code} {r.text[:120]}")
+
+
+def _wait_for_pose(page, position, fov=None):
+    page.wait_for_function("""([pos, fov]) => { const p = window.__camView.lastPose; return p && Math.abs(p.position[0]-pos[0])<1e-6 && Math.abs(p.position[1]-pos[1])<1e-6 && Math.abs(p.position[2]-pos[2])<1e-6 && (fov===null || Math.abs(p.fov-fov)<1e-6); }""",
+                           arg=[list(position), fov], timeout=10000)
+
+
+def test_avatar_moves_live_in_front_of_a_registered_camera(host):
+    base, auth = host["base"], host["auth"]
+    reg = httpx.post(base + "/api/cameras/register", headers=auth, timeout=10, json={
+        "source_id": CAM, "name": "Avatar cam", "location": "studio25d", "tags": ["studio25d"],
+        "position": [0, 1.3, 4.0], "rotation": [0, 0, 0], "fov": 45})
+    assert reg.status_code == 200, reg.text
+    evidence = os.environ.get("CAMERA_EVIDENCE_DIR")
+    if evidence:
+        Path(evidence).mkdir(parents=True, exist_ok=True)
+
+    def keep(name, raw):
+        if evidence:
+            (Path(evidence) / name).write_bytes(raw)
+
+    with sync_api.sync_playwright() as p:
+        try:
+            browser = p.chromium.launch(args=["--no-sandbox"])
+        except Exception as exc:
+            pytest.skip(f"no Chromium available: {exc}")
+        try:
+            page = browser.new_page(viewport={"width": 900, "height": 560})
+            errors = []
+            page.on("pageerror", lambda e: errors.append(str(e)))
+            page.goto(base + f"/login?next=%2Fstatic%2Fcamera_avatar_live.html%3Fcamera%3D{CAM}%26publish%3D1")
+            page.fill("#loginUser", host["user"])
+            page.fill("#loginPass", host["password"])
+            page.keyboard.press("Enter")
+            page.wait_for_url("**/camera_avatar_live**", timeout=20000)
+            try:
+                page.wait_for_function("window.__camView.loaded && window.__camView.published > 3", timeout=45000)
+            except Exception:
+                raise AssertionError("avatar never started publishing frames: " + str(page.evaluate("window.__camView")))
+            view = page.evaluate("window.__camView")
+            assert view["error"] == "" and view["publishErrors"] == 0
+            assert view["repairedBufferViews"] == 7, "manny.glb is spec-invalid on disk and is repaired in memory only"
+            assert {"head", "right_arm", "right_forearm"} <= set(view["mapped"]), "the avatar's bones are bound to the motion consumer"
+
+            # 1. a real avatar is in the camera's frame
+            seq, first, raw = _fetch_frame(host)
+            keep("01_wide.jpg", raw)
+            x0, y0, x1, y1 = _bbox(_avatar_mask(first))
+            assert (y1 - y0) > 120, "the standing avatar fills a good part of the 360 px frame"
+            assert 200 < (x0 + x1) / 2 < 440, "and is near the middle, because the camera looks straight at the origin"
+
+            # 2. it moves: frames from different times differ, and the difference is where the avatar is
+            frames = [first]
+            for _ in range(4):
+                time.sleep(0.35)
+                seq, img, raw = _fetch_frame(host, sequence_after=seq)
+                frames.append(img)
+                keep(f"02_motion_{len(frames)}.jpg", raw)
+            diffs = []
+            for later in frames[1:]:
+                d = np.abs(np.asarray(first).astype(int) - np.asarray(later).astype(int)).sum(axis=2)
+                diffs.append(int((d > 60).sum()))
+            assert max(diffs) > 150, f"live motion changes the picture: changed pixels {diffs}"
+            ever_changed = np.zeros(first.size[::-1], dtype=bool)
+            for later in frames[1:]:
+                ever_changed |= np.abs(np.asarray(first).astype(int) - np.asarray(later).astype(int)).sum(axis=2) > 60
+            ys, xs = np.where(ever_changed)
+            assert x0 - 10 <= xs.min() and xs.max() <= x1 + 40, "the changes are on the avatar, not on the empty set"
+            assert page.evaluate("window.__camView.applied") > 20, "the host's motion commands reached the avatar's bones"
+
+            # 3. moving the camera changes the framing: dolly in makes the avatar bigger
+            moved = httpx.post(base + f"/api/switcher/ptz/{CAM}", headers=auth, timeout=10, json={"position": [0, 1.3, 3.0]})
+            assert moved.status_code == 200, moved.text
+            _wait_for_pose(page, (0, 1.3, 3.0))
+            seq, near, raw = _fetch_frame(host, sequence_after=seq + 1)
+            keep("03_dolly_in.jpg", raw)
+            near_height = _bbox(_avatar_mask(near))[3] - _bbox(_avatar_mask(near))[1]
+            assert near_height > 1.2 * (y1 - y0), f"dolly in from 4 m to 3 m should grow the avatar by about a third: {y1 - y0}px -> {near_height}px tall"
+
+            # 4. pan right: the avatar slides left in the frame
+            reset = httpx.post(base + f"/api/switcher/ptz/{CAM}", headers=auth, timeout=10, json={"position": [0, 1.3, 4.0], "rotation": [0, 0, 0]})
+            assert reset.status_code == 200
+            _wait_for_pose(page, (0, 1.3, 4.0))
+            seq, straight, _ = _fetch_frame(host, sequence_after=seq + 1)
+            sx = (lambda b: (b[0] + b[2]) / 2)(_bbox(_avatar_mask(straight)))
+            panned = httpx.post(base + f"/api/switcher/ptz/{CAM}", headers=auth, timeout=10, json={"rotation": [0, 15, 0]})
+            assert panned.status_code == 200
+            page.wait_for_function("window.__camView.lastPose.rotation[1] === 15", timeout=10000)
+            seq, right, raw = _fetch_frame(host, sequence_after=seq + 1)
+            keep("04_pan_right.jpg", raw)
+            assert (lambda b: (b[0] + b[2]) / 2)(_bbox(_avatar_mask(right))) < sx - 60, "pan right moves the subject left in frame"
+
+            # 5. tilt up: the subject slides down in frame
+            httpx.post(base + f"/api/switcher/ptz/{CAM}", headers=auth, timeout=10, json={"rotation": [0, 0, 0]})
+            page.wait_for_function("window.__camView.lastPose.rotation[1] === 0", timeout=10000)
+            seq, level, _ = _fetch_frame(host, sequence_after=seq + 1)
+            ly = _bbox(_avatar_mask(level))[1]
+            httpx.post(base + f"/api/switcher/ptz/{CAM}", headers=auth, timeout=10, json={"rotation": [10, 0, 0]})
+            page.wait_for_function("window.__camView.lastPose.rotation[0] === 10", timeout=10000)
+            seq, up, raw = _fetch_frame(host, sequence_after=seq + 1)
+            keep("05_tilt_up.jpg", raw)
+            assert _bbox(_avatar_mask(up))[1] > ly + 30, "tilt up moves the subject down in frame"
+            assert errors == []
+        finally:
+            browser.close()
