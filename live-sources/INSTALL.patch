+                "fov": source.fov, "focus": getattr(source, "focus", None),
+            },
+            "program": getattr(cameras.get_program_source(), "source_id", None) == camera_id,
+            "server_time": now,
+            "motion": {"source": "demo_performer", **demo_motion(avatar, now)},
+        }
+
+    return router
