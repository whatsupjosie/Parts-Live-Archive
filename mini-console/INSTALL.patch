diff --git a/static/mini_console.html b/static/mini_console.html
new file mode 100644
index 00000000..34e91e4d
--- /dev/null
+++ b/static/mini_console.html
@@ -0,0 +1,8 @@
+<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>PubCast · On-set mini console</title>
+<style>
+body{margin:0;background:#100f0d;color:#f6e5c5;font:16px system-ui}main{max-width:1000px;margin:auto;padding:18px}a{color:#e9c677}.mini-art{position:relative;aspect-ratio:691/692;overflow:hidden;background:#17100b;border-radius:18px}.mini-art>img:first-child{position:absolute;width:100%;height:auto;top:-61%;pointer-events:none}.mini-screen{object-fit:contain;position:absolute;left:43%;top:18%;width:39%;height:22%;border:2px solid #bd9459;border-radius:8px;background:#06151b}.joystick{position:absolute;left:70%;top:46%;width:16%;height:23%;background:#21332bcc;color:#fff2ba;border:2px solid #bc9458;border-radius:50%;touch-action:none;font-size:19px;cursor:grab}.mini-cut{position:absolute;left:61%;top:69%;width:10%;height:7%}.mini-auto{position:absolute;left:71%;top:72%;width:11%;height:7%}.steering{display:flex;flex-wrap:wrap;gap:9px;padding:14px 0}.steering button,.steering select{font:inherit;padding:10px}.steering output{width:100%;min-height:24px}.joystick:focus-visible{outline:4px solid #fff}.mini-art button{font-weight:bold}.help{font-size:14px;color:#c6b79c}
+</style></head><body><main><h1>On-set mini console</h1><p>Camera control at your station. <a href="/director-console">Director’s console</a> · <a href="/walk">Return to studio</a></p>
+<div class="steering"><label>Camera <select id="mini-camera"></select></label><label>Joystick <select id="mini-mode"><option value="aim">Aim · pan / tilt</option><option value="truck">Move · truck / dolly</option><option value="roll_zoom">Lens · roll / field of view</option></select></label><button id="mini-preview" disabled>Set preview</button><button id="mini-up">Lift</button><button id="mini-down">Lower</button><output id="mini-status" role="status">Connecting…</output></div>
+<div class="mini-art"><img src="/static/control_room_assets/mini_console_reference.png" alt="Leather and brass mini console reference supplied by Curtsey"><img class="mini-screen" id="mini-screen" alt="Selected camera confidence frame" hidden><button class="joystick" id="mini-stick" disabled aria-label="Camera joystick. Arrow keys steer; release to stop">↕ ↔</button><button class="mini-cut" id="mini-cut" disabled>CUT</button><button class="mini-auto" id="mini-auto" disabled>AUTO</button></div>
+<p class="help">Drag the joystick or focus it and use arrow keys. Lift/lower works in Move mode. The monitor shows confidence frames from an active 2.5D studio. Preset 2.5D shots can be switched. Joystick motion is available for movable virtual cameras.</p><p id="mini-feed-status" role="status"></p></main>
+<script src="/static/reach_auth.js"></script><script src="/static/camera_rig.js"></script><script src="/static/studio25d_remote_feed.js"></script><script src="/static/mini_console.js"></script></body></html>
diff --git a/static/mini_console.js b/static/mini_console.js
new file mode 100644
index 00000000..984e3062
--- /dev/null
+++ b/static/mini_console.js
@@ -0,0 +1,170 @@
+(() => {
+  "use strict";
+  const $ = id => document.getElementById("mini-" + id);
+  const camera = $("camera"), mode = $("mode"), stick = $("stick");
+  const rigApi = window.PubCastCameraRig;
+  const degrees = rigApi.DEG;
+  const monitor = window.PubCast25DRemoteFeed.create({
+    targets: { preview: { image: $("screen"), status: $("feed-status") } }
+  });
+  const directions = {
+    aim: ["pan_left", "pan_right", "tilt_up", "tilt_down"],
+    truck: ["move_left", "move_right", "move_forward", "move_back"],
+    roll_zoom: ["roll_left", "roll_right", "zoom_in", "zoom_out"]
+  };
+  const arrows = { ArrowLeft: [-1, 0], ArrowRight: [1, 0], ArrowUp: [0, -1], ArrowDown: [0, 1] };
+  let sources = [], motionTimer = null, refreshTimer, pressedKey, pointer = null, axes;
+  let rig, busy = false, motionVersion = 0, closed = false;
+  const say = text => { $("status").textContent = text; };
+
+  async function request(path, body, method = body ? "POST" : "GET") {
+    const response = await fetch("/api/switcher/" + path, {
+      method, cache: "no-store",
+      headers: body ? { "Content-Type": "application/json" } : undefined,
+      body: body ? JSON.stringify(body) : undefined
+    });
+    if (!response.ok) {
+      if (response.status === 403) throw Error("A moderator role is required for this control.");
+      throw Error("Switcher " + path + " returned HTTP " + response.status);
+    }
+    return response.json();
+  }
+
+  function selectCamera() {
+    stop();
+    const source = sources.find(item => item.id === camera.value);
+    const preset = source?.id.startsWith("p25d_");
+    stick.disabled = !source || preset || !["virtual", "voxel_3d"].includes(source.transport);
+    $("up").disabled = $("down").disabled = stick.disabled || mode.value !== "truck";
+    $("preview").disabled = !source;
+    monitor.setSources(null, preset ? source.id : null);
+    if (!preset) $("feed-status").textContent = "Confidence preview unavailable for this source.";
+  }
+
+  function showState(next) {
+    if (JSON.stringify(sources) !== JSON.stringify(next.sources)) {
+      const previous = camera.value;
+      sources = next.sources;
+      camera.replaceChildren(...sources.map(source => new Option(source.name, source.id)));
+      const preferred = sources.find(source => source.id === previous)
+        || sources.find(source => source.id === next.preview) || sources[0];
+      camera.value = preferred?.id || "";
