+      {
+        "id": "pod_07",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Ask the second question. Everyone has an answer ready for the first one."
