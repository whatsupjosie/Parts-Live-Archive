+      {
+        "id": "pod_10",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Have a show. Not a list of things to say. A show has a beginning, a middle and somewhere it's going."
+      },
+      {
+        "id": "pod_11",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Your voice in the headphones will sound strange to you. Trust it anyway. Everyone else hears the real one."
