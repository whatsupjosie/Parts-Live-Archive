+        "kind": "beat",
+        "topics": [
+          "switcher"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The switcher picks which camera the audience sees. Act for all of them; you never know who's on.",
+        "verify": true
+      },
+      {
+        "id": "pc_10",
+        "kind": "beat",
+        "topics": [
+          "waiting_room"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "New faces wait at the door until they're let in. Manners first, then magic.",
+        "verify": true
+      },
+      {
+        "id": "pc_11",
+        "kind": "beat",
+        "topics": [
