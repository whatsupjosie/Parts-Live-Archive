+      {
+        "id": "pod_12",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Co-hosting is a marriage with a mixing desk. Don't step on each other's lines and never fight on the air."
