+        "kind": "beat",
+        "topics": [
+          "recording"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "When the light goes red, we're recording. Every take's kept. Even the ones you'd rather we didn't.",
+        "verify": true
