+      {
+        "id": "pod_08",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Record a room tone. Thirty seconds of nothing. You'll thank me in the edit."
+      },
+      {
+        "id": "pod_09",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If you're laughing, they're laughing. If you're performing laughing, they're reaching for the skip button."
