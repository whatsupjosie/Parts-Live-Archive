+def _kit_topic(kit: Mapping, topics: Sequence[str]) -> Optional[str]:
+    fillers = kit.get("fillers", {})
+    aliases = kit.get("topic_aliases", {})
+    for t in topics:
+        t = aliases.get(t, t)
+        if t in fillers:
+            return t
+    return None
