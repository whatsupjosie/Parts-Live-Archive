+        h = hashlib.sha256(seed + f"story{attempt}".encode()).digest()
+        p, m, m2 = people[h[0] % len(people)], moves[h[1] % len(moves)], moves[h[2] % len(moves)]
+        d1, d2 = dirs[h[3] % len(dirs)], dirs[h[4] % len(dirs)]
+        if m2 is m:
