+        "id": "pc_05",
+        "kind": "beat",
+        "topics": [
+          "writers_room"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Writers' room's down the hall. 2i, they call it. There's a typewriter in there that clacks like a tap dancer. Lovely for a first draft.",
+        "verify": true
+      },
+      {
+        "id": "pc_06",
+        "kind": "beat",
+        "topics": [
+          "production_notes"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If you have a thought on set, stick a production note on it. Pete reads every one. Eventually.",
+        "verify": true
+      },
+      {
+        "id": "pc_07",
+        "kind": "beat",
+        "topics": [
+          "avatars"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Your avatar's you, only better lit. Treat it like a costume: wear it, don't hide in it.",
+        "verify": true
