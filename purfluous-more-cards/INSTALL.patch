+        "kind": "beat",
+        "topics": [
+          "teleprompter"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The teleprompter is your friend until you read it like one. Glance, don't stare.",
+        "verify": true
+      },
