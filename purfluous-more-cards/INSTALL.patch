+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Guests are nervous too. Give them a drink, a laugh and a soft first question."
+      },
+      {
+        "id": "pod_15",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The cold open is a trailer for the next hour. Pick the best ten seconds and put them first."
+      },
+      {
+        "id": "pod_16",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Show notes are for the people who missed the joke. Keep them short; they're already embarrassed."
+      },
+      {
+        "id": "pod_17",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Water, not coffee, before you record. Coffee sounds like gravel by the third segment."
+      },
+      {
+        "id": "pod_18",
+        "kind": "beat",
+        "topics": [
+          "podcast"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If you mess up, stop, breathe, and say it again clean. That's what editing is for. Don't drag the mistake along with you."
+      },
+      {
+        "id": "pc_01",
+        "kind": "beat",
+        "topics": [
+          "green_room"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The green room's for nerves. Wait there, sit there, breathe there. Nobody's rolling in the green room.",
+        "verify": true
+      },
+      {
+        "id": "pc_02",
+        "kind": "beat",
+        "topics": [
+          "dressing_room"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Your dressing room's your own. Set a room code and nobody gets in but you. I respect a locked door.",
+        "verify": true
+      },
+      {
+        "id": "pc_03",
+        "kind": "beat",
+        "topics": [
+          "control_room"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The control room is where Pete becomes God. Don't touch anything in there with a coloured light on it.",
+        "verify": true
+      },
