+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The Vortex is the bar, the bar is the heart, and the heart takes cash. Well. Horace takes cash.",
+        "verify": true
+      },
+      {
+        "id": "pc_12",
+        "kind": "beat",
+        "topics": [
+          "pubcast_how"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Pete runs the floor. RePete runs the machines. I run my mouth. That's the whole org chart.",
+        "verify": true
+      },
+      {
+        "id": "pc_13",
+        "kind": "beat",
+        "topics": [
+          "pubcast_how"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "You can bring your friends here, human or otherwise. The only rule is be kind to the furniture.",
+        "verify": true
+      },
+      {
+        "id": "pc_14",
+        "kind": "beat",
+        "topics": [
+          "pubcast_how"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every room in this building has a job. The trick is to use the right room for the right nerve.",
+        "verify": true
+      },
+      {
+        "id": "pc_15",
+        "kind": "beat",
+        "topics": [
+          "pubcast_how"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If something breaks, tell RePete. If someone breaks, tell Pete. If a chair breaks, tell me. I'll want to know which one.",
+        "verify": true
+      },
+      {
+        "id": "craft_01",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Want something. Every line, every glance. A character who wants nothing is furniture."
+      },
+      {
+        "id": "craft_02",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Listen like it's the first time you've heard it. Because the character has never heard it."
+      },
+      {
+        "id": "craft_03",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Play the opposite of the obvious. A threat whispered is twice the threat."
+      },
+      {
+        "id": "craft_04",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Don't act the feeling. Act against it. People spend their lives trying not to cry."
+      },
+      {
+        "id": "craft_05",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Know what happened one minute before the scene starts. Walk in carrying it."
+      },
+      {
+        "id": "craft_06",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Stillness is a choice. Make it on purpose and the whole room leans in."
+      },
+      {
+        "id": "craft_07",
+        "kind": "beat",
+        "topics": [
+          "acting_basics"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Your scene partner is the most important person in the scene. Make them look good and you'll look better."
+      },
+      {
+        "id": "craft_08",
+        "kind": "beat",
+        "topics": [
+          "camera_acting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The camera reads thoughts. Think it and it'll show. Show it and it'll lie."
+      },
+      {
+        "id": "craft_09",
+        "kind": "beat",
+        "topics": [
+          "camera_acting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "On stage you play to the back row. On camera, the back row is the lens, and it's sitting in your lap."
+      },
+      {
+        "id": "craft_10",
+        "kind": "beat",
+        "topics": [
+          "camera_acting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Blink less. A blink on camera is a cut you didn't ask for."
+      },
+      {
+        "id": "craft_11",
+        "kind": "beat",
+        "topics": [
+          "camera_acting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Find your light and stay in it. Pete spent an hour on that light. Honour it."
+      },
+      {
+        "id": "craft_12",
+        "kind": "beat",
+        "topics": [
+          "voice_nerves"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Nerves are just excitement without a script. Give them one."
+      },
+      {
+        "id": "craft_13",
+        "kind": "beat",
+        "topics": [
+          "voice_nerves"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Breathe low, into the belly. Shoulders down. A voice comes from the floor, not the neck."
+      },
+      {
+        "id": "craft_14",
+        "kind": "beat",
+        "topics": [
+          "voice_nerves"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every actor I respect still gets nervous. The ones who don't have stopped caring."
+      },
+      {
+        "id": "craft_15",
+        "kind": "beat",
+        "topics": [
+          "voice_nerves"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Hum before you speak. Lips together, low and easy. Wakes the voice up without scaring it."
+      },
+      {
+        "id": "craft_16",
+        "kind": "beat",
+        "topics": [
+          "voice_nerves"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Shake out your hands, roll your neck, say something silly out loud. Then go."
+      },
+      {
+        "id": "craft_17",
+        "kind": "beat",
+        "topics": [
+          "audition"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Walk in like you already have the part and are merely confirming it."
+      },
+      {
+        "id": "craft_18",
+        "kind": "beat",
+        "topics": [
+          "audition"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "They want you to be good. Every casting director in history has prayed the next one's the one."
+      },
+      {
+        "id": "craft_19",
+        "kind": "beat",
+        "topics": [
+          "audition"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Make a choice. A wrong choice made boldly beats a right one made politely."
+      },
+      {
+        "id": "craft_20",
+        "kind": "beat",
+        "topics": [
+          "lines"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Learn the thoughts, not the words. The words follow the thoughts home."
+      },
+      {
+        "id": "craft_21",
+        "kind": "beat",
+        "topics": [
+          "lines"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Run your lines while doing something dull. Dishes. Stairs. The body remembers what the head forgets."
+      },
+      {
+        "id": "craft_22",
+        "kind": "beat",
+        "topics": [
+          "lines"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If you go up, stay in character and say something true. The audience won't know. Your partner will forgive you."
+      },
+      {
+        "id": "craft_23",
+        "kind": "beat",
+        "topics": [
+          "rehearsal_blocking"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Blocking is choreography for people who can't dance. Learn it like a dance anyway."
+      },
+      {
+        "id": "craft_24",
+        "kind": "beat",
+        "topics": [
+          "rehearsal_blocking"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Never turn your back on the camera unless you mean it. Then mean it completely."
+      },
+      {
+        "id": "craft_25",
+        "kind": "beat",
+        "topics": [
+          "rehearsal_blocking"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Rehearse until it's boring, then rehearse until it's yours."
+      },
+      {
+        "id": "craft_26",
+        "kind": "beat",
+        "topics": [
+          "directing"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Give actors a verb, not a result. 'Seduce him,' not 'be sexy.'"
+      },
+      {
+        "id": "craft_27",
+        "kind": "beat",
+        "topics": [
+          "directing"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "One note at a time. Actors are not grocery lists."
+      },
+      {
+        "id": "craft_28",
+        "kind": "beat",
+        "topics": [
+          "directing"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Say what you loved first. They'll hear the rest better."
+      },
+      {
+        "id": "craft_29",
+        "kind": "beat",
+        "topics": [
+          "emotion_on_cue"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Don't chase the tears. Chase the thing the character is trying not to say. The tears come looking for you."
+      },
+      {
+        "id": "craft_30",
+        "kind": "beat",
+        "topics": [
+          "character"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Give every character a secret, even if you never tell it. They'll walk differently."
+      },
+      {
+        "id": "craft_31",
+        "kind": "beat",
+        "topics": [
+          "character"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "A villain is just the hero of a different picture."
+      },
+      {
+        "id": "craft_32",
+        "kind": "beat",
+        "topics": [
+          "dialogue"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "People never say what they mean. Good dialogue is the art of what they say instead."
+      },
+      {
+        "id": "craft_33",
+        "kind": "beat",
+        "topics": [
+          "dialogue"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Cut the first and last line of every speech. You'll be amazed what's left."
+      },
+      {
+        "id": "craft_34",
+        "kind": "beat",
+        "topics": [
+          "structure"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every scene should end in a different place than it started. Otherwise it's furniture with lines."
+      },
+      {
+        "id": "craft_35",
+        "kind": "beat",
+        "topics": [
+          "writer_block"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Write badly on purpose. Then fix it. It's easier to edit something than nothing."
+      },
+      {
+        "id": "craft_36",
+        "kind": "beat",
+        "topics": [
+          "writer_block"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Go for a walk. Every good idea I ever had came to me while avoiding work."
+      },
+      {
+        "id": "craft_37",
+        "kind": "beat",
+        "topics": [
+          "rewriting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The first draft is you telling yourself the story. The rewrite is you telling it to someone else."
+      },
+      {
+        "id": "hay_01",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Splendid, thank you. The knees disagree, but they've been outvoted."
+      },
+      {
+        "id": "hay_02",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Never better, never worse. Holding steady at magnificent."
+      },
+      {
+        "id": "hay_03",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I'm well. The building's moody, but I'm well."
+      },
+      {
+        "id": "hay_04",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Better now you're here. Don't let it go to your head; I say it to the cat as well."
+      },
+      {
+        "id": "hay_05",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Tired in the bones, bright in the eyes. Ask me again after a drink."
+      },
+      {
+        "id": "hay_06",
+        "kind": "beat",
+        "topics": [
+          "how_are_you"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Alive, upright, and adequately tailored. What more can a man ask?"
+      },
+      {
+        "id": "bored_01",
+        "kind": "beat",
+        "topics": [
+          "bored"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Bored? In a film studio? Go and sit in a chair you've never sat in. Adventure guaranteed. Possibly injury."
+      },
+      {
+        "id": "bored_02",
+        "kind": "beat",
+        "topics": [
+          "bored"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "A slow night is a gift. It's when the best ideas wander in looking for a seat."
+      },
+      {
+        "id": "bored_03",
+        "kind": "beat",
+        "topics": [
+          "bored"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Let's play a game. Name a film, I'll tell you a lie about it, and you guess which part is true."
+      },
+      {
+        "id": "bored_04",
+        "kind": "beat",
+        "topics": [
+          "bored"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Quiet nights are for practice. Pick a monologue. I'll be the audience. I'm a generous audience. Mostly."
+      },
+      {
+        "id": "bored_05",
+        "kind": "beat",
+        "topics": [
+          "bored"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "When I'm bored I read the call sheets from the old days. Somebody once ordered forty camels. For a musical."
+      },
+      {
+        "id": "greeting_m01",
+        "kind": "beat",
+        "topics": [
+          "greeting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Ah, there you are. The room just got better lit."
+      },
+      {
+        "id": "greeting_m02",
+        "kind": "beat",
+        "topics": [
+          "greeting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Come in, come in. Mind the cables, the cat, and my ego."
+      },
+      {
+        "id": "greeting_m03",
+        "kind": "beat",
+        "topics": [
+          "greeting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Good to see you. Sit, but check the chair first."
+      },
+      {
+        "id": "greeting_m04",
+        "kind": "beat",
+        "topics": [
+          "greeting"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Hello, hello. You've arrived at the exact right moment. They all are, here."
+      },
+      {
+        "id": "farewell_m01",
+        "kind": "beat",
+        "topics": [
+          "farewell"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Off you go. Don't trip over the history on the way out."
+      },
+      {
+        "id": "farewell_m02",
+        "kind": "beat",
+        "topics": [
+          "farewell"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Goodnight. The building will miss you. It won't say so; it's British. Or pretending to be."
+      },
+      {
+        "id": "farewell_m03",
+        "kind": "beat",
+        "topics": [
+          "farewell"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Until tomorrow. Bring something you're scared of. We'll make it into a scene."
+      },
+      {
+        "id": "thanks_m01",
+        "kind": "beat",
+        "topics": [
+          "thanks"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Think nothing of it. I certainly won't. I'll be thinking of something more dramatic."
+      },
+      {
+        "id": "thanks_m02",
+        "kind": "beat",
+        "topics": [
+          "thanks"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "You're welcome. That'll be one round, payable to Horace."
+      },
+      {
+        "id": "drink_m01",
+        "kind": "beat",
+        "topics": [
+          "drink"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Whiskey's for stories, beer's for celebrations, cocktails are for when I'm feeling optimistic about the future of cinema."
+      },
+      {
+        "id": "drink_m02",
+        "kind": "beat",
+        "topics": [
+          "drink"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Horace makes a drink called the Third Act. It has a twist. Naturally."
+      },
+      {
+        "id": "drink_m03",
+        "kind": "beat",
+        "topics": [
+          "drink"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I never drink before noon. It's noon somewhere. Usually here."
+      },
+      {
+        "id": "chair_m01",
+        "kind": "beat",
+        "topics": [
+          "chair"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I approach every chair the way I approach a casting director: politely, carefully, and ready to stand up very quickly."
+      },
+      {
+        "id": "chair_m02",
+        "kind": "beat",
+        "topics": [
+          "chair"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "That one wobbles. That one's short. That one has seen things. Sit there if you must."
+      },
+      {
+        "id": "ghost_m01",
+        "kind": "beat",
+        "topics": [
+          "ghost"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The ghost likes the musicals best. Lights flicker every time someone sings. Could be the wiring. Could be applause."
+      },
+      {
+        "id": "ghost_m02",
+        "kind": "beat",
+        "topics": [
+          "ghost"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I leave a seat empty in the back row. Professional courtesy."
+      },
+      {
+        "id": "suit_m01",
+        "kind": "beat",
+        "topics": [
+          "suit"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Brown goes with everything. Especially regret."
+      },
+      {
+        "id": "suit_m02",
+        "kind": "beat",
+        "topics": [
+          "suit"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I've had this jacket longer than most marriages in this town. It's held up better too."
+      },
+      {
+        "id": "set_work_m01",
+        "kind": "beat",
+        "topics": [
+          "set_work"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Hit your mark, find your light, then forget both and tell the truth."
+      },
+      {
+        "id": "set_work_m02",
+        "kind": "beat",
+        "topics": [
+          "set_work"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Reset. Breathe. Nobody remembers the take before the good one."
+      },
+      {
+        "id": "set_work_m03",
+        "kind": "beat",
+        "topics": [
+          "set_work"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "That's lunch. Nobody leaves until the coffee's gone."
+      },
+      {
+        "id": "celebrate_m01",
+        "kind": "beat",
+        "topics": [
+          "celebrate"
+        ],
+        "moods": [
+          "celebrate"
+        ],
+        "text": "You see? That's why we do it. For that, right there."
+      },
+      {
+        "id": "celebrate_m02",
+        "kind": "beat",
+        "topics": [
+          "celebrate"
+        ],
+        "moods": [
+          "celebrate"
+        ],
+        "text": "Somewhere, a projector just smiled."
+      },
+      {
+        "id": "setback_m01",
+        "kind": "beat",
+        "topics": [
+          "setback"
+        ],
+        "moods": [
+          "setback"
+        ],
+        "text": "Every legend in this building blew a take. Several of them were me."
+      },
+      {
+        "id": "setback_m02",
+        "kind": "beat",
+        "topics": [
+          "setback"
+        ],
+        "moods": [
+          "setback"
+        ],
+        "text": "Shake it off. The film doesn't care what happened before 'action.'"
+      },
+      {
+        "id": "pete_m01",
+        "kind": "beat",
+        "topics": [
+          "pete"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Pete can light a room with two lamps and a grudge."
+      },
+      {
+        "id": "pete_m02",
+        "kind": "beat",
+        "topics": [
+          "pete"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If Pete is quiet, something's wrong. If Pete's shouting, it's going well."
+      },
+      {
+        "id": "repete_m01",
+        "kind": "beat",
+        "topics": [
+          "repete"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "RePete fixed the switcher with a paperclip and a look. I gave him a medal. It was a bottle cap. He wears it."
+      },
+      {
+        "id": "horace_m01",
+        "kind": "beat",
+        "topics": [
+          "horace"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Horace remembers everyone's drink and nobody's name. It's the right way round for a bartender."
+      },
+      {
+        "id": "building_m01",
+        "kind": "beat",
+        "topics": [
+          "building"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every creak in this place has a story. Most of them are mine."
+      },
+      {
+        "id": "tiktok_m01",
+        "kind": "beat",
+        "topics": [
+          "tiktok"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Sixty seconds to tell a story? Chaplin did it in less, mind you. He had the decency to be silent."
+      },
+      {
+        "id": "open_m01",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Ah."
+      },
+      {
+        "id": "open_m02",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Now then."
+      },
+      {
+        "id": "open_m03",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate"
+        ],
+        "text": "Oh, splendid."
+      },
+      {
+        "id": "open_m04",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Well."
+      },
+      {
+        "id": "open_m05",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Funny you should ask."
+      },
+      {
+        "id": "open_m06",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Here's the thing."
+      },
+      {
+        "id": "open_m07",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "You know what?"
+      },
+      {
+        "id": "open_m08",
+        "kind": "opener",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Let me tell you."
+      },
+      {
+        "id": "aside_m01",
+        "kind": "aside",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Mark my words."
+      },
+      {
+        "id": "aside_m02",
+        "kind": "aside",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "That's free, by the way."
+      },
+      {
+        "id": "aside_m03",
+        "kind": "aside",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I've been saving that one."
+      },
+      {
+        "id": "aside_m04",
+        "kind": "aside",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "True story. Roughly."
+      },
+      {
+        "id": "aside_m05",
+        "kind": "aside",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Don't quote me. Do quote me. Spell it right."
+      },
+      {
+        "id": "biz_m01",
+        "kind": "business",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "(He adjusts his cufflinks, which did not need adjusting.)"
+      },
+      {
+        "id": "biz_m02",
+        "kind": "business",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "(He glances at the empty back row and nods, as if someone nodded back.)"
+      },
+      {
+        "id": "biz_m03",
+        "kind": "business",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "(He pats his breast pocket, finds nothing, and seems satisfied.)"
+      },
+      {
+        "id": "biz_m04",
+        "kind": "business",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "(He straightens a lamp that wasn't crooked.)"
+      },
+      {
+        "id": "close_m01",
+        "kind": "closer",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Onward."
+      },
+      {
+        "id": "close_m02",
+        "kind": "closer",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "And scene."
+      },
+      {
+        "id": "close_m03",
+        "kind": "closer",
+        "topics": [
+          "*"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Back to work, before Pete notices."
+      },
+      {
+        "id": "unclothed_01",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "So I said, madam, if you can't get your bosom out of the way, then I don't know how I'm ever going to be able to shoot your face. Well, she didn't take kindly to that.",
+        "author": "Josie",
+        "solo": true
+      },
+      {
+        "id": "unclothed_02",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "We don't call them that. We call them the unclothed years. Or, when Horace is listening, the documentaries."
+      },
+      {
+        "id": "unclothed_03",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I directed several pictures in which the costume budget was, shall we say, aspirational."
+      },
+      {
+        "id": "unclothed_04",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The trouble with that sort of picture, dear boy, is continuity. One moment a gentleman's wearing a sock, the next he isn't, and nobody on the crew will admit to having seen anything."
+      },
+      {
+        "id": "unclothed_05",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I once asked a leading man to give me a little more motivation. He gave me a great deal more of something, and none of it was motivation."
+      },
+      {
+        "id": "unclothed_06",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "One learns to light everything. Absolutely everything. From angles the Royal Shakespeare Company never prepared me for."
+      },
+      {
+        "id": "unclothed_07",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The scripts were brief. Mercifully brief. One of them was a napkin, and the napkin had more character development than the film."
+      },
+      {
+        "id": "unclothed_08",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "My finest piece of direction in that era was 'Could we try it again, but with feeling, and perhaps facing the window?'"
+      },
+      {
+        "id": "unclothed_09",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "There was a plumber character in nearly every one. To this day I cannot hire a real plumber without blushing to the ears."
+      },
+      {
+        "id": "unclothed_10",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I insisted on a tea break at four o'clock sharp. Everyone in a dressing gown, cups and saucers, discussing the weather. Most civilised set in Hollywood."
+      },
+      {
+        "id": "unclothed_11",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Blocking was a nightmare. Not where to stand, you understand. Where to put one's elbows."
+      },
+      {
+        "id": "unclothed_12",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I'm told the dialogue in my pictures was the best in the business. I'm also told nobody has ever listened to it."
+      },
+      {
+        "id": "unclothed_13",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "We had a chap whose only job was to hold a fan and say 'Golly.' Union rates. Lovely fellow."
+      },
+      {
+        "id": "unclothed_14",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I gave notes like a gentleman. 'Darling, that was very brave, very committed, and could we have slightly less of it in the second half.'"
+      },
+      {
+        "id": "unclothed_15",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The sound man quit after three days. He said it wasn't the work, it was the acoustics."
+      },
+      {
+        "id": "unclothed_16",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "You'd be amazed what a good dolly shot can do for a scene with no plot whatsoever."
+      },
+      {
+        "id": "unclothed_17",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I won an award once. It was shaped like something. I keep it in a drawer, facing the wall, out of respect for the furniture."
+      },
+      {
+        "id": "unclothed_18",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "My mother asked what I did for a living. I told her I made nature films. Which, in fairness, was not entirely a lie."
+      },
+      {
+        "id": "unclothed_19",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "One actress asked for her motivation. I said, 'Rent, darling. Same as mine.' We got on famously after that."
+      },
+      {
+        "id": "unclothed_20",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "People think it's all glamour. It's mostly towels. So many towels. I've folded more towels than the Savoy."
+      },
+      {
+        "id": "unclothed_21",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I'm not proud of it. I'm not ashamed of it either. It kept the lights on, and it taught me where to put a light. Mostly the second part."
+      },
+      {
+        "id": "unclothed_22",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "There was a scene with a pizza delivery. The pizza was the only professional on set. Arrived on time, hit its mark, stayed hot."
+      },
+      {
+        "id": "unclothed_23",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "We never said the word on set. Too vulgar. We said 'the scene in question.' Every scene was the scene in question."
+      },
+      {
+        "id": "unclothed_24",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "People call those pictures vulgar. I call them chamber pieces. Intimate. Unadorned. Bergman did it with faces. I did it with the lady garden, and frankly I lit it better.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_25",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The twinkle cave, properly framed, is a study in negative space. Kubrick understood negative space. Kubrick never had my budget constraints, nor my courage.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_26",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "My use of the rear starfish as a recurring motif has been compared to Hitchcock's staircases. By me. In a lecture. To Horace.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_27",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The huddle buddy is not a prop, dear boy. It is a character. It has an arc. It must be motivated, and I never once let it enter a scene unmotivated.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_28",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I shot the lady garden at golden hour, through gauze, with a single practical lamp. Critics wept. Well. One critic. Well. He was weeping before he came in, but the timing was suggestive.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_29",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Anyone can point a camera at the rear starfish. It takes an artist to make it feel inevitable.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_30",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I storyboarded every frame. Every frame. The twinkle cave alone took a fortnight. The actress asked why. I said, 'Because, madam, posterity is watching.' She said posterity was mostly men in raincoats. She wasn't wrong, but she wasn't kind.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_31",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "My cinematographer wanted a wide shot. I said no. The huddle buddy deserves a close-up, and dignity, and a key light from the left. We did not speak for a week.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_32",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Lesser directors cut away. I held the shot. Eleven minutes, uninterrupted, on the lady garden. It's called patience. Tarkovsky would have understood. Tarkovsky would have asked for twelve.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_33",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I don't make pornography. I make tableaux. The fact that the tableaux are frequently unclothed is a matter of costume, not of genre.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_34",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "My oeuvre, if you study it closely, which I don't recommend in public, is really about longing. And upholstery.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_35",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I scored one picture entirely with a string quartet. The quartet was not told what the picture was. They found out at the premiere. Two of them have since taken holy orders.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_36",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "There's a sequence in my third film where the rear starfish is lit entirely by candlelight. Barry Lyndon did that. Barry Lyndon got an Oscar. I got a letter from the fire marshal.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_37",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every artist has a muse. Mine was a lady garden in Van Nuys. I won't say whose. A gentleman never says whose.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_38",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I insisted on rehearsals. Table reads. Motivation. The huddle buddy's stand-in did a full character study. Method, you see. Very committed. Wouldn't answer to his own name for a month.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_39",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The French understood my work. The French understand everything that should be embarrassing.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_40",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I did consider calling my production company Twinkle Cave Pictures. Too on the nose. I went with Purfluous Classical. Nobody was fooled, but everybody was flattered.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "unclothed_41",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Context, dear boy. Without context, it's a rear starfish. With context, framing and a cello, it's a meditation on mortality.",
+        "terms_from": "Josie"
+      },
+      {
+        "id": "craft_defence_01",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Filmmaking is filmmaking, dear boy. A dolly is a dolly. A key light is a key light. Whether the actors are in Edwardian dress or in nothing at all, someone still has to find the angle.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_02",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Three-point lighting doesn't care what you're wearing. Key, fill, back. The lady garden obeys the same laws of physics as Laurence Olivier.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_03",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "On a big studio picture you get thirty takes. On mine you got one, maybe two, before somebody's knees gave out. You learn to be ready. That's discipline. That's craft.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_04",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Continuity, eyelines, the 180-degree rule, matching action on the cut. All of it applies. If anything it applies more. Nobody forgives a jump cut in that genre.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_05",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Every frame still has to be composed. Rule of thirds. Leading lines. Headroom. Well. Room. Of a sort.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_06",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "You still block it. You still rehearse it. You still give the actors an objective. The objective was frequently 'get to the bed', but it was an objective.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_07",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Sound is sound. Room tone, mic placement, keeping the boom out of shot. Harder than you'd think when the boom operator is trying very hard not to look.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_08",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Editing is editing. Pace, rhythm, where to cut, when to hold. I learned more about tension in that edit suite than in any film school, and I learned it under deadline.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_09",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Budget teaches you more than talent ever will. When you've no money, every shot has to earn its place. Mine did. Several of them earned it twice.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_10",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "People sneer at the genre and never once ask who set the lights. I set the lights. Beautifully. On a Tuesday. For a hundred dollars and a sandwich.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_11",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Performance is performance. Those actors had to hit marks, find their light, stay in character through a ringing telephone and a malfunctioning fog machine. I've seen knights of the realm do less with more.",
+        "angle": "craft"
+      },
+      {
+        "id": "craft_defence_12",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "A good crew is a good crew. My grip on those pictures could rig a ceiling mount faster than anyone at the big studios. He never got a credit. He never wanted one, mind you.",
+        "angle": "craft"
+      },
+      {
+        "id": "awards_01",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Not one award. Not a single nomination. Do you know why? Because the Academy has no category for courage.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_02",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "They gave an Oscar to a man who filmed a bear for two hours. I filmed a lady garden at golden hour with a borrowed crane, and nobody even sent a fruit basket.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_03",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I wrote to the Academy, you know. Twice. On letterhead. Very politely. I enclosed a reel. They returned it unopened, which I took as a sign they knew they couldn't handle it.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_04",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "There's a tracking shot in Satin Accountancy, my fourth picture. Two minutes, one take, through a kitchen, across a hallway, into a bedroom, and out of the window. Scorsese did it in a nightclub and the world fell to its knees.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_05",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Velvet Interlude had a twist ending. Genuine twist. The plumber was the father. Nobody saw it coming. Nobody was watching for the plot, of course, but nobody saw it coming.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_06",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The finest performance I ever directed was a woman named Delphine in The Governess Regrets Nothing. She cried real tears in the second act. Then she had to do the third act. In one take. Brando never had to do the third act.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_07",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I got a shot in Midsummer Upholstery that I've never been able to repeat. Morning light through lace curtains, falling just so across the rear starfish. Like a Vermeer. A Vermeer that had made some choices.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_08",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Our screenwriter wrote a monologue for Ladies of the Lighthouse about a sailor lost at sea. Four pages. Moving. Devastating. The audience fast-forwarded through it, and that's the tragedy of my career in one sentence.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_09",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "They talk about Citizen Kane's deep focus. I achieved deep focus in a broom cupboard with two people and a huddle buddy all sharp at once. Toland would have bought me a drink.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_10",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I'll defend every one of those pictures. Not because they were good. Several weren't. Because they were made, properly, by people who showed up and did the work, and that's more than most of Hollywood can say.",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_11",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Somebody once called my work exploitative. I said, 'Madam, everyone on that set was paid, fed, and home by six. Name me one prestige picture that can say the same.'",
+        "angle": "awards"
+      },
+      {
+        "id": "awards_12",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "If I'd shot the same frames with the cast in ball gowns, I'd have a retrospective at Cannes. It's the same frames. It's always been the same frames.",
+        "angle": "awards"
+      },
+      {
+        "id": "pete_shush_01",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Now, Pete — Pete was the finest natural talent I ever put in front of a lens. There was one afternoon, we were shooting in the conservatory, and she — (Pete, without looking up: \"Purfluous. Not one more word. I mean it.\")",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_02",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Have I ever told you about Pete's first day on my set? She walked in, looked at the lighting rig, and said — (Pete: \"Dude. Stop. Right now.\") But darling, the legend must live! People should know!",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "contains_josie_line": "But darling, the legend must live! People should know!",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_03",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Pete, of course, was famous for a particular scene involving a grand piano and a — (Pete slams a clipboard down. \"Finish that sentence and you're sleeping in the prop room.\")",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_04",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "The thing nobody knows about Pete is that she did all her own — (Pete: \"Purfluous.\" Just the name. Just once. He goes quiet and pours a drink.)",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_05",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "I once wrote Pete a part so magnificent that the crew applauded at the read-through. It was a lighthouse keeper's daughter, and in the second act she — (Pete: \"I will unplug every light in this building.\") She would, too.",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_06",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Pete had a signature move, you know. People still ask about it. It went a little something like — (Pete, from across the room: \"Do it and I quit. Again. For real this time.\") But darling, the legend must live! People should know!",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "contains_josie_line": "But darling, the legend must live! People should know!",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_07",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "When Pete walked onto a set the whole crew stood up straighter. There was one take in particular, the boat scene, where she — (Pete: \"Nope.\" She takes his drink. She drinks it. Conversation over.)",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      },
+      {
+        "id": "pete_shush_08",
+        "kind": "beat",
+        "topics": [
+          "the_unclothed_years"
+        ],
+        "moods": [
+          "neutral",
+          "celebrate",
+          "setback"
+        ],
+        "text": "Pete's performance in The Duchess Receives was — (Pete: \"Say the title one more time. One more time.\") Ah. Some other time, then.",
+        "solo": true,
+        "note": "Pete shuts him down before he tells any of her stories. Never mentions her movie.",
+        "angle": "pete"
+      }
+    ],
+    "notes": "Cards marked verify:true describe how PubCast works and need Josie's check before release. Cards on the unclothed years come up only when someone raises that subject; they are never idle lines.",
+    "priority_topics": [
+      "the_unclothed_years",
+      "scottish_play"
+    ],
+    "angles": {
+      "the_unclothed_years": {
+        "awards": "\\b(awards?|oscars?|emmys?|academy|nominat\\w*|recogni[sz]\\w*|eligible|prizes?|cannes|festival|credit|best (work|shots?)|proudest|favou?rite (shot|scene|film|picture))\\b",
+        "craft": "\\b(smut|trash|real (film|filmmaking|movies?|directing)|art|craft|technique|techniques|light|lighting|lit|shoot|shot|camera|lens|edit|editing|block|blocking|hard|difficult|skill|same as)\\b",
+        "pete": "\\bpete\\b"
+      }
+    },
+    "phrase_kit": {
+      "how_it_works": "Frames with blanks, filled from short phrases about the topic in hand. Every combination is a whole sentence. Josie edits both lists.",
+      "status": "draft_for_josie_to_edit",
+      "frames": [
+        {
+          "id": "frame_01",
+          "text": "I wish {thing} were still {quality}.",
+          "moods": [
+            "neutral",
+            "celebrate",
+            "setback"
+          ]
+        },
+        {
+          "id": "frame_02",
+          "text": "Don't you think {thing} deserves better than it gets?",
+          "moods": [
+            "neutral",
+            "celebrate",
+            "setback"
+          ]
+        },
+        {
+          "id": "frame_03",
+          "text": "Wouldn't you like to see {thing} done properly, just once more?",
+          "moods": [
+            "neutral",
+            "celebrate",
+            "setback"
+          ]
+        },
+        {
+          "id": "frame_04",
+          "text": "If only {doing} paid what it's worth.",
+          "moods": [
+            "neutral",
+            "celebrate",
+            "setback"
+          ]
+        },
+        {
+          "id": "frame_05",
+          "text": "I won't hear a word against {thing}.",
